<![CDATA[# ╔══════════════════════════════════════════════════════════════════╗
# ║                    ReelIfy — Configurações                     ║
# ╚══════════════════════════════════════════════════════════════════╝

# ==========================================
# TELEGRAM BOT (Gratuito via @BotFather)
# ==========================================
TELEGRAM_BOT_TOKEN=seu_token_aqui_do_botfather

# IDs de Telegram autorizados separados por vírgula (ex: 123456789,987654321)
# Deixe vazio para permitir qualquer usuário (apenas em desenvolvimento)
ALLOWED_CHAT_IDS=

# ==========================================
# GOOGLE GEMINI AI (Gratuito via aistudio.google.com)
# ==========================================
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-2.0-flash

# ==========================================
# FILA & ARMAZENAMENTO
# ==========================================
QUEUE_FILE_PATH=data/queue.json
MEDIA_INPUTS_DIR=data/media/inputs
MEDIA_OUTPUTS_DIR=data/media/outputs
LOGS_DIR=data/logs

# ==========================================
# AUTOMAÇÃO ADB & HARDWARE
# ==========================================
# True  = Modo simulado (sem celular físico — ideal para desenvolvimento e testes)
# False = Modo produção (celular Android conectado via USB com YouTube Create)
MOCK_DEVICE=True

# Intervalo em segundos entre verificações da fila de pedidos
WORKER_POLL_INTERVAL=15

# Serial do dispositivo ADB (opcional — vazio usa o único conectado)
ADB_DEVICE_SERIAL=
]]>
