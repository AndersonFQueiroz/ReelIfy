# ╔══════════════════════════════════════════════════════════════════╗
# ║                    ReelIfy — Configurações                     ║
# ╚══════════════════════════════════════════════════════════════════╝

# ==========================================
# TELEGRAM BOT (Via @BotFather)
# ==========================================
TELEGRAM_BOT_TOKEN=seu_token_aqui_do_botfather

# IDs de Telegram autorizados separados por vírgula (ex: 123456789,987654321)
# IDs permitidos; deixe vazio para usar a palavra mágica ou autorizações persistentes

# Administradores que podem usar /autorizar e /revogar
ADMIN_CHAT_IDS=
ALLOWED_CHAT_IDS=

# ==========================================
# GOOGLE GEMINI AI (Via aistudio.google.com)
# ==========================================
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_IMAGE_MODEL=
AGENT_DB_PATH=data/agent.db

# Palavra compartilhável para liberar o próprio Telegram permanentemente
MAGIC_WORD=defina-uma-palavra-secreta

# ==========================================
# FILA & ARMAZENAMENTO
# ==========================================
QUEUE_FILE_PATH=data/queue.json
MEDIA_INPUTS_DIR=data/media/inputs
MEDIA_OUTPUTS_DIR=data/media/outputs
LOGS_DIR=data/logs

# ==========================================
# AUTOMAÇÃO ADB & HARDWARE
# ==========================================
# True  = Modo simulado (sem celular físico — ideal para desenvolvimento e testes)
# False = Modo produção (celular Android conectado via USB com YouTube Create)
MOCK_DEVICE=True

# Intervalo em segundos entre verificações da fila de pedidos
WORKER_POLL_INTERVAL=15

# Serial do dispositivo ADB (opcional — vazio usa o único conectado)
ADB_DEVICE_SERIAL=

# ==========================================
# FÁBRICA DIÁRIA — 3 vídeos CaçaOfertas
# ==========================================
# Shopee Afiliado (gera offerLink/shortlink na oferta do dia)
SHOPEE_APP_ID=
SHOPEE_SECRET=
SHOPEE_API_BASE=https://open-api.affiliate.shopee.com.br

# ML Afiliado (template matt_* — vitrine curta continua no bot/LG)
ML_MATT_TOOL=42852450
ML_MATT_WORD=andersonferreiraqueiroz

# Hugging Face (B-roll IA do vídeo 1; vazio = fallback POV 100% local)
HF_TOKEN=
HF_VIDEO_MODEL=Lightricks/LTX-Video-0.9.8-13B-distilled

# Telegram — entrega do pack no privado do dono
# TELEGRAM_BOT_TOKEN=token de um bot teu (pode ser o do CaçaOfertas)
# TELEGRAM_OWNER_CHAT_ID=seu chat id (fale com @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_CHANNEL_PREVIEW=cacaofertasofcBR

# ==========================================
# BUFFER — auto-post IG + TikTok + YouTube (grátis)
# 1. Crie conta em buffer.com (plano Free: 3 canais)
# 2. Conecte 1x: Instagram + TikTok + YouTube (login normal, sem review)
# 3. Gere a chave: publish.buffer.com → Settings → API → New key
# ==========================================
BUFFER_API_KEY=
# Kwai não tem suporte em nenhuma ferramenta → pack manual no Telegram.

